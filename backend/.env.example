# ============================================================
# CareConnect Backend — Environment Variables Template
# ============================================================
# COPY this file to .env and fill in real values.
# NEVER commit real production secrets or credentials to git.
# ============================================================

# Oracle JDBC Connection
# Format: jdbc:oracle:thin:@<host>:<port>/<service_name>
ORACLE_JDBC_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ORACLE_DB_USERNAME=CARECONNECT123
ORACLE_DB_PASSWORD=careconnect123

# CORS Frontend Origin
CARECONNECT_CORS_ALLOWED_ORIGIN=http://localhost:5173

# JWT Security
# Generate a cryptographically secure random string with at least 256 bits (32+ chars)
# Example: openssl rand -base64 48
JWT_SECRET=careconnect-super-secure-production-ready-jwt-secret-key-at-least-256-bits-long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Cookie Security (set COOKIE_SECURE=true for HTTPS in staging/production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Email OTP Configuration
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_INTERVAL_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMTP Email Provider Settings
# If left blank, the backend reports required SMTP configuration in logs
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=saniyasarkar7867@gmail.com
SPRING_MAIL_PASSWORD=saniya786
MAIL_FROM=noreply@careconnect.com
